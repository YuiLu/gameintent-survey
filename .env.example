# Server only. Copy to .env.local for local development. Never commit real values.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@COPY_POOLER_HOST_FROM_SUPABASE:6543/postgres
# Optional PEM CA from Supabase settings for certificate verification.
DATABASE_CA_CERT=
STUDY_ADMIN_KEY=REPLACE_WITH_RANDOM_64_HEX
STUDY_INITIAL_POOL=1
