{
  "name": "gameintent-survey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:esa": "node scripts/build-esa.mjs",
    "start": "next start",
    "test": "node --test tests/analysis.test.mjs tests/cos.test.mjs tests/database.test.mjs tests/errors.test.mjs tests/database-tls.test.mjs tests/gateway.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:flow": "tsx tests/run-flow.ts",
    "test:flow:esa": "STUDY_TEST_GATEWAY=1 tsx tests/run-flow.ts",
    "test:ui": "node --import tsx --test tests/ui.test.tsx tests/pilot.test.ts tests/four-choice.test.ts",
    "test:deno": "deno run --no-config --no-lock --allow-env --allow-read tests/deno-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "next": "16.4.4",
    "postgres": "3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
